# Compass - frontend. Sirve los estaticos y hace de proxy hacia la API.
#
# El proxy no es un detalle: con el, la pagina y la API comparten origen, y entonces
# no hace falta CORS, ni que el navegador conozca la URL del backend, ni autorizar un
# origen distinto en el cliente de OAuth de Google.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Cabeceras de seguridad basicas. El frontend carga el SDK de Google para el login,
    # asi que no se puede poner una CSP restrictiva sin listarlo; se deja para cuando
    # se defina con calma.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # --- API ---------------------------------------------------------------- #
    # Se listan las rutas del backend en vez de mandar todo lo desconocido: asi un
    # error de ruteo devuelve 404 aqui y no se convierte en una peticion rara al
    # backend. `analisis` es el sondeo de un trabajo encolado (ver core/trabajos.py).
    location ~ ^/(analizar|analisis|informe\.pdf|salud|health|auth)(/|$) {
        proxy_pass ${COMPASS_BACKEND};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Subida de documentos. El limite de verdad lo aplica el backend
        # (DOCS_MAX_MB_TOTAL); este solo tiene que ser mayor para no cortar antes y
        # dejar al analista sin el mensaje que explica que se paso.
        client_max_body_size 120m;

        # El analisis se encola y se sondea, asi que ninguna peticion deberia quedar
        # abierta minutos. El margen es para el modo sincrono (`asincrono` vacio), que
        # se conserva por compatibilidad y ahi si espera a que termine.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        # Sin buffering: el sondeo son respuestas chicas y frecuentes.
        proxy_buffering off;
    }

    # --- Estaticos ---------------------------------------------------------- #
    # config.json lo genera el arranque del contenedor con la URL real de la API: no
    # se puede cachear o el navegador se quedaria con la de otro entorno.
    location = /config.json {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # index.html tampoco: es lo que trae la version nueva de app.js tras un despliegue.
    location = / {
        add_header Cache-Control "no-store" always;
        try_files /index.html =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
    }

    # Las banderas no cambian nunca.
    location /banderas/ {
        add_header Cache-Control "public, max-age=604800" always;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
